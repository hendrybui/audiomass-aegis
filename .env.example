# AudioMass AEGIS — Backend Configuration
# Copy to .env and fill in values

# Server
AUDIOMASS_PORT=5055
AUDIOMASS_HOST=0.0.0.0

# Security
API_KEY=replace-with-at-least-32-character-secret

# Upload limits
MAX_UPLOAD_BYTES=536870912

# Concurrent job limits (prevent OOM on limited hardware)
MAX_CONCURRENT_JOBS=2

# Logging
LOG_LEVEL=INFO

# Stem separation (Demucs)
DEMUCS_MODEL=htdemucs
DEMUCS_DEVICE=cpu

# Whisper transcription
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# CORS
CORS_ORIGINS=*
